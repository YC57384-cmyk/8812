attenuation_pct <- function(total_model, adjusted_model, coef_name = "region_finalYunnan") {
  total_beta <- coef(total_model)[coef_name]
  adj_beta <- coef(adjusted_model)[coef_name]
  (total_beta - adj_beta) / total_beta * 100
}


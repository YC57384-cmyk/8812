decode_onehot_score <- function(data, cols, score_map) {
  mat <- data[, cols, drop = FALSE]
  picked <- !is.na(mat)
  no_pick <- rowSums(picked) == 0
  multi_pick <- rowSums(picked) > 1
  
  pos <- apply(picked, 1, function(x) {
    idx <- which(x)
    if (length(idx) == 1) idx else NA_integer_
  })
  
  score <- score_map[pos]
  score[no_pick | multi_pick] <- NA_real_
  return(score)
}


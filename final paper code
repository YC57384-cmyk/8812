extract_med <- function(x, dv_name) {
  data.frame(
    DV = dv_name,
    ACME_est = x$d0,
    ACME_CI_low = x$d0.ci[1],
    ACME_CI_high = x$d0.ci[2],
    ACME_p = x$d0.p,
    ADE_est = x$z0,
    ADE_CI_low = x$z0.ci[1],
    ADE_CI_high = x$z0.ci[2],
    ADE_p = x$z0.p,
    Total_est = x$tau.coef,
    Total_CI_low = x$tau.ci[1],
    Total_CI_high = x$tau.ci[2],
    Total_p = x$tau.p,
    PropMed_est = x$n0,
    PropMed_CI_low = x$n0.ci[1],
    PropMed_CI_high = x$n0.ci[2],
    PropMed_p = x$n0.p
  )
}


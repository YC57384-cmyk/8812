  GVP_reduction_pct = attenuation_pct(m_c_gvp, m_exec_gvp_r),
  GVR_reduction_pct = attenuation_pct(m_c_gvr, m_exec_gvr_r),
  GVS_reduction_pct = attenuation_pct(m_c_gvs, m_exec_gvs_r)
)

